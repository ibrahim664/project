void buy(clistpro& p, clistcus& c, clistord& o) {
    // Prompt user for input
    cout << "Enter customer ID: ";
    int customerId;
    cin >> customerId;

    // Check if customer exists in the customer list
    customer* currentCustomer = c.phead;
    while (currentCustomer != NULL) {
        if (currentCustomer->cid == customerId) {
            break;
        }
        currentCustomer = currentCustomer->pnext;
    }

    if (currentCustomer == NULL) {
        // Create a new customer and add it to the customer list
        customer* newCustomer = new customer;
        newCustomer->cid = customerId;
        // ... (assign values to newCustomer members if needed)
        newCustomer->pnext = NULL;
        c.attach(newCustomer);
        currentCustomer = newCustomer;
    }

    // Prompt user for input
    cout << "Enter product ID: ";
    int productId;
    cin >> productId;

    // Find the product and decrement the stock
    product* productToBuy = NULL;
    product* currentProduct = p.phead;
    while (currentProduct != NULL) {
        if (currentProduct->pid == productId) {
            productToBuy = currentProduct;
            break;
        }
        currentProduct = currentProduct->pnext;
    }
    if (currentProduct == NULL)
    {
        product* newproduct = new product;
        newproduct->pid = productId;
        cout << "enter the new prod"; cin >> newproduct->pname;
        newproduct->pnext = NULL;
        p.attach(newproduct);
        currentProduct = newproduct;
    }
    if (productToBuy != NULL) {
        // Prompt user for input
        cout << "Enter quantity: ";
        int quantity;
        cin >> quantity;

        // Check if sufficient stock is available
        if (productToBuy->stock >= quantity) {
            // Decrement the stock
            productToBuy->stock -= quantity;

            // Prompt user for input
            cout << "Enter purchase month: ";
            int purchaseMonth;
            cin >> purchaseMonth;

            // Prompt user for input
            cout << "Enter purchase year: ";
            int purchaseYear;
            cin >> purchaseYear;

            // Create a new order and add it to the order list
            orders* newOrder = new orders;
            newOrder->pid = productId;
            newOrder->cid = customerId;
            newOrder->totprc = quantity * productToBuy->prc;
            newOrder->purm = purchaseMonth;
            newOrder->pury = purchaseYear;
            // ... (assign values to newOrder members if needed)
            newOrder->pnext = NULL;
            o.attach(newOrder);

            cout << "Order placed successfully." << endl;
        }
        else {
            cout << "Insufficient stock." << endl;
        }
    }
    else {
        cout << "Product not found." << endl;
    }
}
void returnProduct(clistpro& p, clistord& o, int customerId, int productId) {
    // Find the order with the specified customer and product IDs
    orders* currentOrder = o.phead;
    orders* previousOrder = NULL;
    while (currentOrder != NULL) {
        if (currentOrder->cid == customerId && currentOrder->pid == productId) {
            break;
        }
        previousOrder = currentOrder;
        currentOrder = currentOrder->pnext;
    }

    if (currentOrder != NULL) {
        // Increment the stock of the product
        product* currentProduct = p.phead;
        while (currentProduct != NULL) {
            if (currentProduct->pid == productId) {
                currentProduct->stock++;
                break;
            }
            currentProduct = currentProduct->pnext;
        }

        // Remove the order node from the list
        if (previousOrder != NULL) {
            previousOrder->pnext = currentOrder->pnext;
        }
        else {
            o.phead = currentOrder->pnext;
        }
        delete currentOrder;

        // Update the orders file
        ofstream orderFile("orders.txt");
        if (orderFile.is_open()) {
            orders* orderNode = o.phead;
            while (orderNode != NULL) {
                orderFile << orderNode->cid << "," << orderNode->pid << "," << orderNode->totprc << "," << orderNode->purm << "," << orderNode->pury << "\n";
                orderNode = orderNode->pnext;
            }
            orderFile.close();
        }
        else {
            cout << "Error: Unable to open orders file." << endl;
        }

        cout << "Product returned successfully." << endl;
    }
    else {
        cout << "No matching order found." << endl;
    }
}


