#include <iostream>
#include <fstream>
#include <string>
using namespace std;

class product {
public:
    int pid;
    string pname;
    int stock;
    int prc;
    int expm;
    int expy;
    product* pnext;
};

class clistpro {
public:
    product* phead;
    product* ptail;

    clistpro() {
        phead = NULL;
        ptail = NULL;
    }

    ~clistpro() {
        product* ptv;
        ptv = phead;
        while (ptv != NULL) {
            phead = phead->pnext;
            delete ptv;
            ptv = phead;
        }
    }

    void attach(product* pnn) {
        if (phead == NULL) {
            phead = pnn;
            ptail = pnn;
        }
        else {
            ptail->pnext = pnn;
            ptail = pnn;
        }
    }

    void display() {
        product* ptv = phead;
        while (ptv != NULL) {
            cout << ptv->pid << ' ';
            cout << ptv->pname << ' ';
            cout << ptv->prc << ' ';
            cout << ptv->expm << ' ';
            cout << ptv->expy << endl;
            ptv = ptv->pnext;
        }
    }
};

